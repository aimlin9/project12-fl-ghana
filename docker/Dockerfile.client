FROM python:3.11-slim

WORKDIR /app

# Build tools needed for ctgan (meson/C compiler) and scipy
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    build-essential python3-dev ninja-build && \
    rm -rf /var/lib/apt/lists/*

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy project files
COPY . .

# Set PYTHONPATH
ENV PYTHONPATH=/app

# Default command — docker-compose.yml overrides this per service with the
# right --school; this default just keeps the image runnable standalone.
CMD ["python", "scripts/run_client.py", "--school", "school_alpha", "--server", "server:8088"]
